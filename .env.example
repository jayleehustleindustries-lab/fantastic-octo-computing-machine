# Required for application intake. Applications become leads in the
# JayLeeFit Client Hub's "Lead Pipeline" table. The token needs
# data.records:read + data.records:write on that base.
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=appN8QFsoWJ1fJhxC
# AIRTABLE_LEADS_TABLE=Lead Pipeline

# Optional. Only payment self-reports still use MySQL; without it the payment
# form stays disabled and clients send proof of payment by email.
DATABASE_URL=

# Required for the live AI blueprint generator in a Manus-compatible runtime.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional package prices revealed after a completed qualification.
FOUNDATION_PRICE=Contact for Pricing
RECOMP_PRICE=Contact for Pricing
LEGACY_PRICE=Contact for Pricing

# Optional analytics. Both values must be set before the browser loads Umami.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional Manus OAuth/runtime integration.
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
