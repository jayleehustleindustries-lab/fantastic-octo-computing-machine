# Required for application intake and payment reports. Applications become
# leads in the JayLeeFit Client Hub's "Lead Pipeline" table; payment reports go
# to its "Payment Reports" table for manual review. The token needs
# data.records:read + data.records:write on that base.
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=appN8QFsoWJ1fJhxC
# AIRTABLE_LEADS_TABLE=Lead Pipeline
# AIRTABLE_PAYMENTS_TABLE=Payment Reports

# Claude API. Switches on the "Ask Jay" assistant (free tier, Claude Haiku 5.5)
# and Remap program builds (paid only, Claude Opus 5.5). Without it the chat
# shows "coming soon" and the browser-only plan builder is shown instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_FREE_MODEL=claude-haiku-5-5
# ANTHROPIC_PAID_MODEL=claude-opus-5-5

# Remap checkout (Stripe). All three plus Airtable and the Claude key must be
# set before the Buy button opens. Use test keys on staging. The webhook
# endpoint in Stripe is https://<site>/api/stripe/webhook for the
# checkout.session.completed event.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price in cents, e.g. 9700 for $97.
REMAP_PRICE_CENTS=
# The site's public origin: Stripe return links and the Claude connector's
# address. Defaults to the request's host (Stripe) or Railway's domain (MCP).
# PUBLIC_SITE_URL=https://www.jayleefit.com
# AIRTABLE_REMAP_TABLE=Remap Orders

# Optional. Only stores generated AI plans; nothing else needs a database.
DATABASE_URL=

# Optional package prices revealed after a completed qualification.
FOUNDATION_PRICE=Contact for Pricing
RECOMP_PRICE=Contact for Pricing
LEGACY_PRICE=Contact for Pricing

# Optional analytics. Both values must be set before the browser loads Umami.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional Manus runtime integration. Visitor login and /manus-storage are
# only switched on when these are set; the public site doesn't need them.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Claude connector (MCP server at /mcp). Off until both are set.
# Your sign-in password when you connect Claude (10+ characters).
MCP_OWNER_PASSWORD=
# Any random string of 32+ characters. Changing it signs every Claude out.
MCP_SIGNING_SECRET=
# Optional: extra OAuth callback URLs, comma-separated. Claude's are built in.
# MCP_EXTRA_REDIRECT_URIS=
