# API auth — API refuses every request (503) until this is set
COMMERCIAL_ENGINE_API_KEY=

DATABASE_PATH=data/commercial_engine.db
MANIFESTS_DIR=manifests
SCREEN_RECORDINGS_DIR=assets/screen_recordings
BROLL_DIR=assets/broll
WORK_DIR=data/work
OUTPUT_DIR=data/outputs

# Narrator for every scene (the presenter lip-syncs to this audio)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Stock HeyGen presenter — pick one from your HeyGen avatar library
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_BACKGROUND_COLOR=#0B0F14
HEYGEN_POLL_INTERVAL_SECONDS=10
HEYGEN_TIMEOUT_SECONDS=900

# Only "files" is implemented: drop clips at BROLL_DIR/{scene_id}.mp4
BROLL_PROVIDER=files

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

HUD_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
HUD_MAX_CHARS=32

# End card — set CTA_TEXT to your real offer once it's decided
BRAND_NAME=JobCommand
CTA_TEXT=Book. Dispatch. Get paid.
CTA_URL=jobcommand.app
END_CARD_SECONDS=2.5

ELEVENLABS_CONCURRENCY=3
HEYGEN_CONCURRENCY=2
FFMPEG_CONCURRENCY=2
PROVIDER_MAX_ATTEMPTS=3
STALE_CLAIM_SECONDS=3600
